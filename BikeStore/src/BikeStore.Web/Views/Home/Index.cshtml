@using System.Globalization
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var currencyCulture =
        CultureInfo.GetCultureInfo("en-US");
}

<section class="dashboard-page">

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="dashboard-api-alert">
            <i class="bi bi-exclamation-triangle"></i>

            <div>
                <strong>No se pudieron cargar las bicicletas</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    }

    <article class="dashboard-hero">
        <div class="dashboard-hero-content">
            <span class="dashboard-kicker">
                BIKESTORE · EQUIPO DE 5
            </span>

            <h1>¡Bienvenidos, equipo BikeStore!</h1>

            <strong>
                Cinco integrantes, una misma ruta.
            </strong>

            <p>
                Consulta el estado general de la tienda y sus módulos.
            </p>
        </div>

        <div class="dashboard-hero-illustration"
             aria-hidden="true">
            <i class="bi bi-bicycle"></i>
        </div>
    </article>

    <section class="dashboard-stats">

        <article class="dashboard-stat-card">
            <div class="dashboard-stat-icon blue">
                <i class="bi bi-bicycle"></i>
            </div>

            <div>
                <span>Bicicletas</span>
                <strong>@Model.TotalBicycles</strong>
                <small>Registradas en el catálogo</small>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <div class="dashboard-stat-icon green">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <span>Clientes</span>
                <strong>—</strong>
                <small>Pendiente de integración</small>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <div class="dashboard-stat-icon orange">
                <i class="bi bi-currency-dollar"></i>
            </div>

            <div>
                <span>Ventas de hoy</span>
                <strong>—</strong>
                <small>Pendiente de integración</small>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <div class="dashboard-stat-icon red">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div>
                <span>Stock bajo</span>
                <strong>@Model.LowStockBicycles</strong>
                <small>Requieren reposición</small>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <div class="dashboard-stat-icon pink">
                <i class="bi bi-box-seam"></i>
            </div>

            <div>
                <span>Agotadas</span>
                <strong>@Model.OutOfStockBicycles</strong>
                <small>Sin unidades disponibles</small>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <div class="dashboard-stat-icon purple">
                <i class="bi bi-wallet2"></i>
            </div>

            <div>
                <span>Valor de existencias</span>

                <strong>
                    @Model.InventoryValue.ToString(
                        "C2",
                        currencyCulture)
                </strong>

                <small>Precio por unidades disponibles</small>
            </div>
        </article>

    </section>

    <section class="dashboard-panels">

        <article class="dashboard-panel">
            <header class="dashboard-panel-header">
                <h2>Resumen de bicicletas</h2>
            </header>

            @if (!Model.HasBicycles)
            {
                <div class="dashboard-empty">
                    <div class="dashboard-empty-icon">
                        <i class="bi bi-bicycle"></i>
                    </div>

                    <h3>Aún no hay bicicletas registradas</h3>

                    <p>
                        Registra una bicicleta para comenzar a llenar
                        el catálogo.
                    </p>

                    <a class="button primary"
                       asp-controller="Bicicletas"
                       asp-action="Crear">
                        <i class="bi bi-plus-lg"></i>
                        Registrar bicicleta
                    </a>
                </div>
            }
            else
            {
                <div class="dashboard-bicycle-list">

                    @foreach (var bicycle in Model.BicyclesToWatch)
                    {
                        var statusClass =
                            bicycle.Stock == 0
                                ? "out"
                                : bicycle.Stock <= 5
                                    ? "low"
                                    : "available";

                        <div class="dashboard-bicycle-row">

                            <div class="dashboard-bicycle-icon">
                                <i class="bi bi-bicycle"></i>
                            </div>

                            <div class="dashboard-bicycle-name">
                                <strong>@bicycle.Brand</strong>

                                <span>
                                    @bicycle.Model · @bicycle.Category
                                </span>
                            </div>

                            <div class="dashboard-bicycle-stock">
                                <strong>@bicycle.Stock</strong>
                                <span>unidades</span>
                            </div>

                            <span class="dashboard-bicycle-status @statusClass">
                                @bicycle.Status
                            </span>

                        </div>
                    }

                    <div class="dashboard-panel-actions">
                        <a class="button primary"
                           asp-controller="Bicicletas"
                           asp-action="Index">
                            <i class="bi bi-bicycle"></i>
                            Ver catálogo completo
                        </a>
                    </div>

                </div>
            }
        </article>

        <article class="dashboard-panel">
            <header class="dashboard-panel-header">
                <h2>Estado de los módulos</h2>
            </header>

            <div class="dashboard-module-list">

                <div class="dashboard-module-row">
                    <div class="dashboard-module-icon blue">
                        <i class="bi bi-bicycle"></i>
                    </div>

                    <strong>Bicicletas</strong>

                    <span class="dashboard-module-dot green"></span>

                    <span class="dashboard-module-status ready">
                        Operativo
                    </span>
                </div>

                <div class="dashboard-module-row">
                    <div class="dashboard-module-icon blue">
                        <i class="bi bi-grid"></i>
                    </div>

                    <strong>Categorías</strong>

                    <span class="dashboard-module-dot orange"></span>

                    <span class="dashboard-module-status">
                        En desarrollo
                    </span>
                </div>

                <div class="dashboard-module-row">
                    <div class="dashboard-module-icon green">
                        <i class="bi bi-people"></i>
                    </div>

                    <strong>Clientes</strong>

                    <span class="dashboard-module-dot green"></span>

                    <span class="dashboard-module-status">
                        En desarrollo
                    </span>
                </div>

                <div class="dashboard-module-row">
                    <div class="dashboard-module-icon red">
                        <i class="bi bi-cart3"></i>
                    </div>

                    <strong>Ventas</strong>

                    <span class="dashboard-module-dot red"></span>

                    <span class="dashboard-module-status">
                        En desarrollo
                    </span>
                </div>

                <div class="dashboard-module-row">
                    <div class="dashboard-module-icon purple">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <strong>Inventario</strong>

                    <span class="dashboard-module-dot purple"></span>

                    <span class="dashboard-module-status">
                        En desarrollo
                    </span>
                </div>

            </div>
        </article>

    </section>

</section>